# https://github.com/tfeldmann/organize
# Supercronic-based build with multi-arch support

FROM python:3.11-slim

# ARG_01 = PUID:PGID (e.g., "1000:1000"), defaults to 1000:1000
ARG ARG_01=1000:1000

# Latest supercronic releases: https://github.com/aptible/supercronic/releases
ARG SUPERCRONIC_VERSION=v0.2.47
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl tzdata ca-certificates bash busybox jq \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) bin=supercronic-linux-amd64; sha1=712d2ece75da6f6e530192a151488578153e4e96 ;; \
      arm64) bin=supercronic-linux-arm64; sha1=93323899ddca3f1198f1796a4bf4418ed1e7982e ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSLO "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/${bin}"; \
    echo "${sha1}  ${bin}" | sha1sum -c -; \
    install -m 755 "$bin" /usr/local/bin/supercronic; \
    rm "$bin"

RUN pip install --no-cache-dir organize-tool

ARG VERSION DOCKERFILE IMAGE_FOR_TESTING BUILD_TIME
LABEL org.opencontainers.image.created=${BUILD_TIME} \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.dockerfile=${DOCKERFILE} \
      org.opencontainers.image.image_for_testing=${IMAGE_FOR_TESTING}

WORKDIR /app

COPY programs/organize-tool/scripts_global/ /app/scripts_global/
COPY programs/organize-tool/entrypoint.sh /entrypoint.sh
COPY programs/organize-tool/config/crontab.default /app/config/crontab.default

ARG ARG_01=1000:1000
RUN PUID="$(echo "$ARG_01" | cut -d: -f1)" \
 && PGID="$(echo "$ARG_01" | cut -d: -f2)" \
 && EXISTING_GROUP="$(getent group "$PGID" | cut -d: -f1)" \
 && if [ -n "$EXISTING_GROUP" ]; then \
      GROUP_NAME="$EXISTING_GROUP"; \
    else \
      GROUP_NAME="appgroup"; \
      groupadd -g "$PGID" "$GROUP_NAME"; \
    fi \
 && useradd -l -u "$PUID" -g "$GROUP_NAME" -m appuser \
 && chmod +x /app/scripts_global/* /entrypoint.sh \
 && mkdir -p /app/state /app/scripts_user \
 && chown -R appuser:"$GROUP_NAME" /app

ENV PATH="/app/scripts_user:/app/scripts_global:${PATH}"

USER appuser

ENTRYPOINT ["/entrypoint.sh"]
